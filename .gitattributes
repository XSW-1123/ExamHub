# 默认按文本处理并统一为 LF，避免 Windows / macOS 之间产生整文件 diff
* text=auto eol=lf

# 批处理脚本必须是 CRLF，否则 cmd.exe 解析异常
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件，禁止换行转换与文本 diff
*.docx binary
*.doc binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# 题库数据是构建产物，折叠 diff 以免污染评审视图
data/questions.js linguist-generated=true
js/marked.min.js linguist-vendored=true
